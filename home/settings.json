{
  "model": "sonnet",
  "agent": "general",
  "language": "english",
  "autoCompactWindow": 140000,
  "cleanupPeriodDays": 60,
  "autoUpdatesChannel": "stable",
  "plansDirectory": "./.claude/plans",
  "theme": "dark-ansi",
  "tui": "fullscreen",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"[\\(.model.display_name)] \\(.context_window.used_percentage // 0)% | \\(.effort.level // env.CLAUDE_CODE_EFFORT_LEVEL // \"?\")\"'"
  },
