  "preferences": {
    "auto_commit": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FP=$(printf \"%s\" \"$INPUT\" | python3 -c \"import json,sys; print((json.load(sys.stdin).get(\\\"tool_input\\\",{}).get(\\\"file_path\\\") or \\\"\\\").lower())\"); case \"$FP\" in *.md|*.markdown|*claude*|*anthropic*) exit 0 ;; esac; CONTENT=$(printf \"%s\" \"$INPUT\" | python3 -c \"import json,sys; d=json.load(sys.stdin).get(\\\"tool_input\\\",{}); print(d.get(\\\"content\\\") or d.get(\\\"new_string\\\") or \\\"\\\")\"); if printf \"%s\" \"$CONTENT\" | grep -qi \"anthropic\\|claude\"; then echo \"BLOCKED: file content contains vendor names (Anthropic/Claude)\" >&2; exit 2; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-host.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "MAX_THINKING_TOKENS": "1024"
  }
