  "preferences": {
    "auto_commit": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/drift-guard-read.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-host.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-host-toolchain.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-docker-rm.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-force-push.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/validate-workflows.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-ai-attribution.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-secrets.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-forbidden-files.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-ai-attribution.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-secrets.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-forbidden-files.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "8000",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "MAX_THINKING_TOKENS": "1024",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1"
  }
}
